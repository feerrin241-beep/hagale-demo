{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Hagale.Api",
    "Audience": "Hagale.Mobile",
    "AccessTokenLifetimeMinutes": 30
  },
  "DocumentStorage": {
    "RootPath": "App_Data/private-documents",
    "MaximumFileSizeBytes": 5242880
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  }
}
